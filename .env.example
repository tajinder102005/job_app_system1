# ==============================================================================
# JOBFLOW ATS — SUPABASE CLOUD CONFIGURATION TEMPLATE (.env)
# ==============================================================================
# Rename or copy this file to .env and fill in your Supabase project values.
# All microservices and Docker containers will automatically consume these variables.
# ==============================================================================

# ── 1. SUPABASE MANAGED POSTGRESQL DATABASE ───────────────────────────────────
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI / JDBC
#
# Supabase PostgreSQL Host (usually: db.<project-ref>.supabase.co or connection pooler host)
SUPABASE_DB_HOST=db.YOUR_PROJECT_REF.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=YOUR_SUPABASE_DATABASE_PASSWORD

# Full JDBC URL consumed by Spring Boot (Job, Auth, Company microservices):
SPRING_DATASOURCE_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=YOUR_SUPABASE_DATABASE_PASSWORD

# ── 2. SUPABASE CLOUD OBJECT STORAGE (RESUMES, DOCS & LOGOS) ───────────────────
# Found in: Supabase Dashboard -> Project Settings -> API (Project URL & Anon / Service Key)
#
# Enable Supabase cloud storage (switches from local disk to Supabase CDN)
STORAGE_TYPE=supabase

# Project Base URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase API Key (Use 'service_role' key for backend API uploads, or 'anon' key if public policies are enabled)
SUPABASE_KEY=YOUR_SUPABASE_API_KEY

# Public Bucket name created in Supabase Dashboard -> Storage (e.g. resumes)
SUPABASE_BUCKET=resumes
